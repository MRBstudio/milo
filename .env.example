# Local:  docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=milo -e POSTGRES_DB=milo postgres:16
DATABASE_URL="postgresql://postgres:milo@localhost:5432/milo"

# Operator login secret. Must be at least 12 characters — the operator API
# refuses every request when it is unset or shorter than that.
# Generate one with: openssl rand -base64 24
OPERATOR_PASSWORD=""
